# ULAK yerel geliştirme ayarları
# Bu dosyayı .env olarak kopyalayın: copy .env.example .env

# --- EVREN LLM Gateway (AI analizi ve takip sohbeti için zorunlu) ---
EVREN_API_KEY=
EVREN_API_URL=https://evren-llmapi.ssyz.org.tr/v1
# Yavaş reasoning modelleri için yanıt zaman aşımı (ms). Varsayılan: 300000
# EVREN_TIMEOUT_MS=300000

# --- Yerel depolama ---
# Yüklenen arşivler ve (DATABASE_URL yoksa) SQLite veritabanı burada tutulur.
# Göreli yollar depo köküne göre çözülür; proje klasörünü taşısanız da veriler
# proje içinde kalır. Mutlak yol da verebilirsiniz.
ULAK_DATA_DIR=./.ulak-data

# --- Veritabanı (opsiyonel) ---
# Boş bırakılırsa yerel SQLite kullanılır. Doluysa MySQL kullanılır.
# DATABASE_URL=mysql://kullanici:sifre@127.0.0.1:3306/ulak

# --- Sunucu ---
# Geliştirmede API portu `pnpm dev` tarafından 3001 olarak atanır.
# PORT=3000
# Varsayılan bağlama adresi 127.0.0.1'dir (yalnızca bu makine). Aynı ağdaki
# başka cihazlardan erişmek isterseniz 0.0.0.0 verin; bu durumda kimlik
# doğrulaması olmadığını unutmayın.
# ULAK_HOST=127.0.0.1

# --- Yükleme sınırı ---
# Arşiv yükleme ve GitHub indirmesi için üst sınır (MB). Varsayılan: 25
# ULAK_MAX_UPLOAD_MB=25

# --- Tek kullanıcı modu ---
# Yerel kurulumda tüm projeler tek sahip altında toplanır. `0` verirseniz her
# oturum jetonu ayrı bir sahip olur.
# ULAK_SINGLE_USER=1
