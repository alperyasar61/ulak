{
  "name": "@ulak/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-server/src/index.js",
  "scripts": {
    "dev": "cross-env ULAK_DEV_API_PORT=3001 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-native.mjs",
    "start": "node dist-server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "7zip-min": "3.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "canonicalize": "^5.1.0",
    "express": "5.1.0",
    "multer": "2.0.2",
    "mysql2": "3.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.0",
    "cross-env": "^10.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "^5.0.5"
  }
}
