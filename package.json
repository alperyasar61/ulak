{
  "name": "ulak-project-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm --filter @ulak/backend dev\" \"pnpm --filter @ulak/frontend dev\"",
    "build": "pnpm --filter @ulak/backend build && pnpm --filter @ulak/frontend build",
    "start": "pnpm --filter @ulak/backend start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ulak/backend test",
    "verify:tools": "node scripts/verify-tools.mjs",
    "manifest:tools": "node scripts/generate-tools-manifest.mjs"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  }
}
